# Server Configuration
PORT=8080

# Database Configuration (PostgreSQL)
# Hosted (e.g. Render): set DATABASE_URL instead; it takes precedence over the DB_* values below.
# DATABASE_URL=postgresql://user:password@host:5432/gymtracker
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gymtracker
DB_SSLMODE=disable

# CORS: comma-separated frontend origins allowed to call the API (no trailing slash, no "*").
# Production must include the deployed Vercel URL. Unset = local dev origins only.
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Security & JWT Configuration (required; the server will not start without it).
# Generate your own with: openssl rand -hex 32  (never reuse this placeholder in production)
JWT_SECRET=replace-with-a-long-random-secret

# AI Fitness Coach Configuration (Optional - Google Gemini 1.5 Flash)
# If left empty, GymTracker automatically uses the built-in strength knowledge engine
GEMINI_API_KEY=

